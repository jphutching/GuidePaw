APP_ENV=production
APP_NAME=GuidePaw Beta PG
APP_SHORT_NAME=GuidePaw
APP_URL=https://your-app.onrender.com
APP_STORAGE_PATH=/data
DB_DRIVER=pgsql
DB_HOST=your-render-postgres-host
DB_PORT=5432
DB_DATABASE=guidepaw
DB_USERNAME=guidepaw
DB_PASSWORD=change-me

APP_MODE=beta
APP_BETA_BANNER_ENABLED=true
APP_BETA_BANNER_LABEL=BETA / MIGRATION BUILD

APP_ALLOW_DB_MIGRATIONS=false
APP_DEBUG=false

API_TOKEN_TTL_DAYS=90

# Optional community links.
GUIDEPAW_DISCORD_INVITE_URL=https://discord.gg/your-invite
GUIDEPAW_MERCH_STORE_URL=https://your-store.example.com
GUIDEPAW_SUPPORT_FUNDING_URL=https://your-funding.example.com

# Optional Stripe funding checkout.
# Use live secret and price IDs in Render Environment, not in Git.
GUIDEPAW_STRIPE_SECRET_KEY=sk_live_replace_me
GUIDEPAW_STRIPE_API_VERSION=2026-02-25.clover
GUIDEPAW_STRIPE_WEBHOOK_SECRET=whsec_replace_me
GUIDEPAW_STRIPE_FUNDING_ONE_TIME_PRICE_ID=price_replace_me_once
GUIDEPAW_STRIPE_FUNDING_MONTHLY_PRICE_ID=price_replace_me_monthly

# Optional SMTP for beta approval emails through Zoho.
# Add actual secret values in Render Environment, not in Git.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USERNAME=admin@guidepaw.app
SMTP_PASSWORD=change-me-in-render-only
SMTP_FROM=admin@guidepaw.app
SMTP_FROM_NAME=GuidePaw
MAIL_FROM_ADDRESS=admin@guidepaw.app
MAIL_FROM_NAME=GuidePaw

# Optional Zoho ZeptoMail HTTPS API for transactional email.
# Add actual token in Render Environment, not in Git.
ZEPTO_API_URL=https://api.zeptomail.com/v1.1/email
ZEPTO_SEND_MAIL_TOKEN=change-me-in-render-only
# Optional OAuth token if you want GuidePaw to read ZeptoMail email logs for cost/usage snapshots.
ZEPTO_OAUTH_TOKEN=
ZEPTO_FROM_ADDRESS=admin@guidepaw.app
ZEPTO_FROM_NAME=GuidePaw
ZEPTO_BOUNCE_ADDRESS=
