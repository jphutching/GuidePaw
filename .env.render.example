APP_ENV=production
APP_NAME=GuidePaw Beta PG
APP_SHORT_NAME=GuidePaw
APP_URL=https://your-app.onrender.com
APP_STORAGE_PATH=/data
DB_DRIVER=pgsql
DB_HOST=your-render-postgres-host
DB_PORT=5432
DB_DATABASE=guidepaw
DB_USERNAME=guidepaw
DB_PASSWORD=change-me

APP_MODE=beta
APP_BETA_BANNER_ENABLED=true
APP_BETA_BANNER_LABEL=BETA / MIGRATION BUILD

APP_ALLOW_DB_MIGRATIONS=false
APP_DEBUG=false

API_TOKEN_TTL_DAYS=90

# Optional SMTP for beta approval emails through Zoho.
# Add actual secret values in Render Environment, not in Git.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USERNAME=admin@guidepaw.app
SMTP_PASSWORD=change-me-in-render-only
SMTP_FROM=admin@guidepaw.app
SMTP_FROM_NAME=GuidePaw
MAIL_FROM_ADDRESS=admin@guidepaw.app
MAIL_FROM_NAME=GuidePaw
