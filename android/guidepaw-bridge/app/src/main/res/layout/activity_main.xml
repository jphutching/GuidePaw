<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="?attr/textAppearanceHeadlineMedium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/bridge_intro" />

        <EditText
            android:id="@+id/endpointInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/endpoint_hint"
            android:inputType="textUri"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/tokenInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/token_hint"
            android:inputType="textPassword"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/dogIdInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/dog_id_hint"
            android:inputType="number"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/dogNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/dog_name_hint"
            android:inputType="textPersonName"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/sourceInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/source_hint"
            android:inputType="text"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save_pairing"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/refreshAccountButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/refresh_account"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/openBridgeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/open_bridge"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/requestAccessButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/request_health_connect"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/syncNowButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sync_now"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/manageAccessButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/manage_access"
            android:layout_marginTop="8dp" />

        <Switch
            android:id="@+id/autoSyncSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auto_sync"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/status_idle" />

        <TextView
            android:id="@+id/lastSyncText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/last_sync_never" />

        <TextView
            android:id="@+id/accountText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/account_summary_empty"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <TextView
            android:id="@+id/dogsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/dogs_summary_empty"
            android:textAppearance="?attr/textAppearanceBodyMedium" />
    </LinearLayout>
</ScrollView>
