<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="?attr/textAppearanceHeadlineMedium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/bridge_intro" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/login_section_label"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <EditText
            android:id="@+id/usernameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/username_hint"
            android:inputType="textEmailAddress"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/passwordInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/password_hint"
            android:inputType="textPassword"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/totpInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/totp_hint"
            android:inputType="numberPassword"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/recoveryInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/recovery_hint"
            android:inputType="text"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/tokenLabelInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/token_label_hint"
            android:inputType="text"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/endpointInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/endpoint_hint"
            android:inputType="textUri"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/tokenInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/token_hint"
            android:inputType="textPassword"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/dogIdInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/dog_id_hint"
            android:inputType="number"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/dogNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/dog_name_hint"
            android:inputType="textPersonName"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/sourceInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/source_hint"
            android:inputType="text"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/loginButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/login_button"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save_pairing"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/refreshAccountButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/refresh_account"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/openBridgeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/open_bridge"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/requestAccessButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/request_health_connect"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/syncNowButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sync_now"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/manageAccessButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/manage_access"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/editHandlerProfileButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/handler_profile_title"
            android:layout_marginTop="8dp" />

        <Switch
            android:id="@+id/autoSyncSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auto_sync"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/status_idle" />

        <TextView
            android:id="@+id/lastSyncText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/last_sync_never" />

        <TextView
            android:id="@+id/accountText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/account_summary_empty"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <TextView
            android:id="@+id/dogsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/dogs_summary_empty"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <LinearLayout
            android:id="@+id/dogsListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Training logs and history"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <TextView
            android:id="@+id/trainingSuggestionsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Training suggestions: load a dog to see next-step guidance."
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <TextView
            android:id="@+id/trainingLogsSummaryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Training logs: save pairing and choose a dog to load history."
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <TextView
            android:id="@+id/trainingLogDetailText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Select a log to view detail."
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <TextView
            android:id="@+id/trainingLogModeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="New log"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <EditText
            android:id="@+id/trainingLogDateInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Date/time (YYYY-MM-DD HH:MM)"
            android:inputType="text" />

        <EditText
            android:id="@+id/trainingLogLocationInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Location name"
            android:inputType="textCapWords" />

        <EditText
            android:id="@+id/trainingLogCityStateInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="City, state"
            android:inputType="textCapWords" />

        <Spinner
            android:id="@+id/trainingLogTypeSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/trainingLogFocusValueText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Focus level: 3/5" />

        <SeekBar
            android:id="@+id/trainingLogFocusSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="4" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Skills practiced"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <LinearLayout
            android:id="@+id/trainingSkillsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp" />

        <EditText
            android:id="@+id/trainingLogNotesInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Handler notes"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:gravity="top" />

        <Button
            android:id="@+id/saveTrainingLogButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Save log" />

        <Button
            android:id="@+id/clearTrainingLogButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Clear form" />

        <Button
            android:id="@+id/refreshLogsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Refresh logs" />

        <LinearLayout
            android:id="@+id/trainingLogsListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Wearable sync"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <TextView
            android:id="@+id/wearableSummaryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Wearable sync: load a dog to see recent Health Connect snapshots."
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <TextView
            android:id="@+id/wearableStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Status: waiting for wearable data"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <TextView
            android:id="@+id/wearableSetupText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Wearable setup: save the tracker and watch pairing on GuidePaw to see it here."
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <TextView
            android:id="@+id/wearableCatalogText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Wearable compatibility catalog"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <Button
            android:id="@+id/wearableRefreshButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Refresh wearable sync" />

        <TextView
            android:id="@+id/wearableEventsSummaryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Recent syncs: none loaded."
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <LinearLayout
            android:id="@+id/wearableEventsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Public QR and found-dog flow"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <TextView
            android:id="@+id/publicProfileSummaryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Public profile: sign in and choose a dog to load QR details." />

        <TextView
            android:id="@+id/publicProfileStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Status: waiting for profile" />

        <ImageView
            android:id="@+id/publicProfileQrImage"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="10dp"
            android:adjustViewBounds="true"
            android:scaleType="centerInside"
            android:contentDescription="QR code for the public profile" />

        <Button
            android:id="@+id/publicProfileRefreshButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Refresh public profile" />

        <Button
            android:id="@+id/publicProfileShareButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Share public profile link" />

        <Button
            android:id="@+id/publicProfileOpenButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Open public profile" />

        <TextView
            android:id="@+id/publicProfileDetailText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Load a profile to see public contact details and notes." />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Public guides"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <Button
            android:id="@+id/publicGuideLandingButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Open public landing" />

        <Button
            android:id="@+id/publicGuideFaqButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Open FAQ" />

        <Button
            android:id="@+id/publicGuideQuestionnaireButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Open breed questionnaire" />

        <Button
            android:id="@+id/publicGuideComparisonButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Open comparison hub" />

        <Button
            android:id="@+id/publicGuideFamilyButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Open family guide" />

        <Button
            android:id="@+id/publicGuideLegalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Open legal info" />

        <Button
            android:id="@+id/publicGuideHousingButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Open housing FAQ" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Found-dog report form"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <EditText
            android:id="@+id/foundLocationInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Location or cross street"
            android:inputType="textCapWords" />

        <EditText
            android:id="@+id/foundNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Your name"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/foundPhoneInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Your phone"
            android:inputType="phone" />

        <EditText
            android:id="@+id/foundMessageInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Optional message"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:gravity="top" />

        <Button
            android:id="@+id/publicReportOpenButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Open found-dog page" />

        <Button
            android:id="@+id/publicReportSubmitButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Send found-dog report" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Support, plans, and add-ons"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <TextView
            android:id="@+id/billingSummaryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Support, plans, and add-ons: sign in and choose a dog to see billing state." />

        <TextView
            android:id="@+id/billingStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Status: waiting for billing data" />

        <Button
            android:id="@+id/billingRefreshButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Refresh billing" />

        <Button
            android:id="@+id/billingSupportOnceButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Support once" />

        <Button
            android:id="@+id/billingSupportMonthlyButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Support monthly" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Plan cards"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <LinearLayout
            android:id="@+id/billingPlanContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="A la carte services"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <LinearLayout
            android:id="@+id/billingServiceContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Support receipts"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <LinearLayout
            android:id="@+id/billingSupportHistoryContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Service purchase receipts"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <LinearLayout
            android:id="@+id/billingPurchaseHistoryContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp" />
    </LinearLayout>
</ScrollView>
