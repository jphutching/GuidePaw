<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dog_access_title"
            android:textAppearance="?attr/textAppearanceHeadlineMedium" />

        <TextView
            android:id="@+id/dogAccessSummaryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/dog_access_summary_empty" />

        <TextView
            android:id="@+id/dogAccessStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/status_idle" />

        <Button
            android:id="@+id/dogAccessRefreshButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/dog_access_refresh" />

        <TextView
            android:id="@+id/dogAccessDogText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/dog_access_dog_empty" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/dog_access_handlers_title"
            android:textAppearance="?attr/textAppearanceTitleMedium" />
        <LinearLayout
            android:id="@+id/dogAccessHandlersContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/dog_access_pending_invites_title"
            android:textAppearance="?attr/textAppearanceTitleMedium" />
        <LinearLayout
            android:id="@+id/dogAccessPendingInvitesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/dog_access_transfer_requests_title"
            android:textAppearance="?attr/textAppearanceTitleMedium" />
        <LinearLayout
            android:id="@+id/dogAccessTransferRequestsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/dog_access_invite_title"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <EditText
            android:id="@+id/dogAccessInviteIdentityInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/dog_access_invite_identity_hint"
            android:inputType="textEmailAddress" />

        <EditText
            android:id="@+id/dogAccessInviteRoleInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/dog_access_invite_role_hint"
            android:inputType="text" />

        <EditText
            android:id="@+id/dogAccessInvitePermissionInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/dog_access_invite_permission_hint"
            android:inputType="text" />

        <EditText
            android:id="@+id/dogAccessInviteEndsAtInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/dog_access_invite_end_date_hint"
            android:inputType="date" />

        <Button
            android:id="@+id/dogAccessInviteButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/dog_access_send_invite" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/dog_access_transfer_title"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <EditText
            android:id="@+id/dogAccessTransferIdentityInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/dog_access_transfer_identity_hint"
            android:inputType="textEmailAddress" />

        <EditText
            android:id="@+id/dogAccessTransferNoteInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/dog_access_transfer_note_hint"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:gravity="top" />

        <CheckBox
            android:id="@+id/dogAccessTransferKeepAccessCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/dog_access_transfer_keep_access" />

        <Button
            android:id="@+id/dogAccessTransferButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/dog_access_send_transfer" />
    </LinearLayout>
</ScrollView>
